columns = 4
alignment = 1
theme_override_constants/h_separation = 9
theme_override_constants/v_separation = 9

[node name="SuppliesPanel" type="VBoxContainer" parent="Layout"]
visible = false
layout_mode = 2
size_flags_vertical = 3
theme_override_constants/separation = 10

[node name="FilterRow" type="HBoxContainer" parent="Layout/SuppliesPanel"]
layout_mode = 2
theme_override_constants/separation = 8

[node name="FilterCycle" type="Button" parent="Layout/SuppliesPanel/FilterRow"]
