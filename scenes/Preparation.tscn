[gd_scene load_steps=4 format=3]

[ext_resource type="Script" path="res://scripts/ui/PreparationScreen.gd" id="1_prepare"]
[ext_resource type="Texture2D" path="res://assets/android/art/scenes/ruins-menu-v2.jpg" id="2_camp"]
[ext_resource type="Script" path="res://scripts/ui/InventoryShelf.gd" id="3_shelf"]

[node name="Preparation" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1_prepare")

[node name="Backdrop" type="ColorRect" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
color = Color(0.012, 0.055, 0.09, 1)
mouse_filter = 2

[node name="CampBackdrop" type="TextureRect" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2
texture = ExtResource("2_camp")
expand_mode = 1
stretch_mode = 6

[node name="Layout" type="VBoxContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
offset_left = 26.0
offset_top = 26.0
offset_right = -26.0
offset_bottom = -26.0
grow_horizontal = 2
grow_vertical = 2
theme_override_constants/separation = 12

[node name="Header" type="HBoxContainer" parent="Layout"]
layout_mode = 2
theme_override_constants/separation = 12

[node name="Title" type="Label" parent="Layout/Header"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_colors/font_color = Color(1, 0.78, 0.24, 1)
theme_override_font_sizes/font_size = 32
text = "整备"

[node name="HeroButton" type="Button" parent="Layout/Header"]
unique_name_in_owner = true
custom_minimum_size = Vector2(170, 50)
layout_mode = 2
text = "英雄：主宰"

[node name="ModeBar" type="HBoxContainer" parent="Layout"]
layout_mode = 2
theme_override_constants/separation = 8

[node name="Loadout" type="Button" parent="Layout/ModeBar"]
toggle_mode = true
button_pressed = true
custom_minimum_size = Vector2(0, 50)
layout_mode = 2
size_flags_horizontal = 3
text = "配装"

[node name="Skills" type="Button" parent="Layout/ModeBar"]
toggle_mode = true
custom_minimum_size = Vector2(0, 50)
layout_mode = 2
size_flags_horizontal = 3
text = "技能"

[node name="Supplies" type="Button" parent="Layout/ModeBar"]
toggle_mode = true
custom_minimum_size = Vector2(0, 50)
layout_mode = 2
size_flags_horizontal = 3
text = "物资"

[node name="Save" type="Button" parent="Layout/ModeBar"]
custom_minimum_size = Vector2(110, 50)
layout_mode = 2
text = "保存"

[node name="PresetRow" type="HBoxContainer" parent="Layout"]
layout_mode = 2
theme_override_constants/separation = 10

[node name="LoadoutRow" type="HBoxContainer" parent="Layout"]
layout_mode = 2

[node name="EquipmentPanel" type="VBoxContainer" parent="Layout/LoadoutRow"]
size_flags_horizontal = 3
layout_mode = 2
theme_override_constants/separation = 9

[node name="Caption" type="Label" parent="Layout/LoadoutRow/EquipmentPanel"]
layout_mode = 2
theme_override_colors/font_color = Color(1, 0.8, 0.34, 1)
theme_override_font_sizes/font_size = 21
text = "战斗装备 · 9 格"

[node name="EquipmentSlots" type="GridContainer" parent="Layout/LoadoutRow/EquipmentPanel"]
layout_mode = 2
size_flags_horizontal = 3
columns = 3
alignment = 1
theme_override_constants/h_separation = 9
theme_override_constants/v_separation = 9

[node name="CardPanel" type="VBoxContainer" parent="Layout"]
visible = false
layout_mode = 2
theme_override_constants/separation = 9

[node name="Caption" type="Label" parent="Layout/CardPanel"]
layout_mode = 2
theme_override_colors/font_color = Color(0.68, 0.55, 1, 1)
theme_override_font_sizes/font_size = 21
text = "技能卡 · 8 格"

[node name="CardSlots" type="GridContainer" parent="Layout/CardPanel"]
