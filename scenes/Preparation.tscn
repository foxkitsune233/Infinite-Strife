[connection signal="pressed" from="Layout/Header/HeroButton" to="." method="_on_hero_pressed"]
[connection signal="pressed" from="Layout/ModeBar/Loadout" to="." method="_on_mode_pressed" binds=["loadout"]]
[connection signal="pressed" from="Layout/ModeBar/Skills" to="." method="_on_mode_pressed" binds=["skills"]]
[connection signal="pressed" from="Layout/ModeBar/Supplies" to="." method="_on_mode_pressed" binds=["supplies"]]
[connection signal="pressed" from="Layout/ModeBar/Save" to="." method="_on_save_pressed"]
