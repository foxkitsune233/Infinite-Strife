[gd_scene load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/ui/ShopScreen.gd" id="1_shop"]

[node name="Shop" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1_shop")

[node name="Backdrop" type="ColorRect" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
color = Color(0.018, 0.045, 0.075, 1)
mouse_filter = 2

[node name="Layout" type="VBoxContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
offset_left = 26.0
offset_top = 26.0
offset_right = -26.0
offset_bottom = -26.0
grow_horizontal = 2
grow_vertical = 2
theme_override_constants/separation = 14

[node name="Header" type="HBoxContainer" parent="Layout"]
layout_mode = 2

[node name="Title" type="Label" parent="Layout/Header"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_colors/font_color = Color(1, 0.78, 0.24, 1)
theme_override_font_sizes/font_size = 32
text = "营地补给"

[node name="Back" type="Button" parent="Layout/Header"]
custom_minimum_size = Vector2(170, 54)
layout_mode = 2
text = "返回整备"

[node name="Gold" type="Label" parent="Layout"]
unique_name_in_owner = true
layout_mode = 2
theme_override_colors/font_color = Color(1, 0.83, 0.34, 1)
theme_override_font_sizes/font_size = 21

[node name="Hint" type="Label" parent="Layout"]
layout_mode = 2
theme_override_colors/font_color = Color(0.55, 0.82, 0.9, 1)
theme_override_font_sizes/font_size = 18
text = "购买物品会直接进入局外仓库；刷新会使旧报价失效。"

[node name="Refresh" type="Button" parent="Layout"]
custom_minimum_size = Vector2(0, 50)
layout_mode = 2
text = "刷新货架"

[node name="Scroll" type="ScrollContainer" parent="Layout"]
layout_mode = 2
size_flags_vertical = 3
horizontal_scroll_mode = 0

[node name="Offers" type="GridContainer" parent="Layout/Scroll"]
layout_mode = 2
size_flags_horizontal = 3
columns = 2
alignment = 1
theme_override_constants/h_separation = 12
theme_override_constants/v_separation = 12

[node name="Status" type="Label" parent="Layout"]
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 52)
layout_mode = 2
theme_override_colors/font_color = Color(0.8, 0.9, 0.95, 1)
theme_override_font_sizes/font_size = 17
autowrap_mode = 2

[connection signal="pressed" from="Layout/Header/Back" to="." method="_on_back_pressed"]
[connection signal="pressed" from="Layout/Refresh" to="." method="_on_refresh_pressed"]
